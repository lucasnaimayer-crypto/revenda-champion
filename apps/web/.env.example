# Projeto Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: leitura de fotos e prints de catálogo por IA (console.anthropic.com).
# Sem as duas variáveis, o app só aceita catálogos em PDF.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=
# Leituras por revendedor a cada 24 horas (padrão 100).
# IA_LIMITE_DIARIO=100
